# Menu
menu.border.color: #EEDCC1

menu.title.bg: Solid Flat
menu.title.bg.color: #262629
menu.title.bg.shadow: 0
menu.title.text.color: #EEDCC1
menu.title.text.justify: Center

menu.items.bg: Solid Flat
menu.items.bg.color: #262629
menu.items.text.color: #EEDCC1
menu.items.disabled.text.color: #bcae9b

menu.items.active.bg: Solid Flat
menu.items.active.bg.color: #b4a7d6
menu.items.active.text.color: #EEDCC1

menu.separator.color: #bcae9b
menu.separator.width: 1
menu.separator.padding.width: 2
menu.separator.padding.height: 4

# Window focused
window.active.title.separator.color: #262629

# Active window
window.active.border.color: #2ebd8e


window.active.title.bg: flat solid
window.active.title.bg.color: #262629
window.active.title.separator.color: #262629
window.active.text.justify: center

window.active.label.bg: parentrelative
window.active.label.text.color: #EEDCC1

window.active.handle.bg: flat solid
window.active.handle.bg.color: #262629

window.active.grip.bg: flat solid
window.active.grip.bg.color: #262629

window.active.button.unpressed.bg: flat solid
window.active.button.unpressed.bg.color: #262629
window.active.button.unpressed.image.color: #EEDCC1

window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #b4a7d6
window.active.button.pressed.image.color: #2B2B2F

window.active.button.disabled.bg: flat solid
window.active.button.disabled.bg.color: #262629
window.active.button.disabled.image.color: #bcae9b

window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #262629
window.active.button.hover.image.color: #b4a7d6

#window.active.button.toggled.bg: #b4a7d6
#window.active.button.toggled.image.color: #2B2B2F

# Inactive window
window.inactive.border.color: #697375

window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #262629
window.inactive.title.separator.color: #262629
window.inactive.text.justify: center

window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #bcae9b

window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #262629

window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #262629

window.inactive.button.unpressed.bg: flat solid
window.inactive.button.unpressed.bg.color: #262629
window.inactive.button.unpressed.image.color: #bcae9b

window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #b4a7d6
window.inactive.button.pressed.image.color: #2B2B2F

window.inactive.button.disabled.bg: flat solid
window.inactive.button.disabled.bg.color: #bcae9b
window.inactive.button.disabled.image.color: #262629

window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #262629
window.inactive.button.hover.image.color: #b4a7d6


# OSD
osd.border.width: 1
osd.border.color: #b4a7d6

osd.bg: flat solid
osd.bg.color: #262629
osd.label.bg: flat solid
osd.label.bg.color: #262629
osd.label.text.color: #EEDCC1

# OSD
osd.bg: Solid Flat
osd.bg.color: #262629
osd.bg.shadow: 0

osd.border.width: 2
osd.hilight.bg: Solid Flat
osd.hilight.bg.color: #b4a7d6
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #2B2B2F

osd.button.unpressed.bg: flat border
osd.button.unpressed.bg.color: #353539
#osd.button.unpressed.*.border.color: #EEDCC1

osd.button.pressed.bg: flat border
osd.button.pressed.bg.color: #b4a7d6
#osd.button.pressed.*.border.color: #2B2B2F

osd.button.focused.bg: flat solid border
osd.button.focused.bg.color: #EEDCC1
#osd.button.focused.*.border.color: #2B2B2F

osd.button.focused.box.color: #b4a7d6


# Fonts
window.active.label.text.font:shadow=n
window.inactive.label.text.font:shadow=n
menu.items.font:shadow=n
menu.title.text.font:shadow=n


# Everything else
border.width: 3
padding.width: 8
padding.height: 3
window.handle.width: 0
window.client.padding.width: 0
window.label.text.justify: center
#menu.overlap: 0
